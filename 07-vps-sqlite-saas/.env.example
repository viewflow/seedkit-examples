DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Cache — separate SQLite DB
# CACHE_DB_PATH=/data/cache.sqlite3

# Email
EMAIL_URL=consolemail://
# DEFAULT_FROM_EMAIL=webmaster@localhost
# SERVER_EMAIL=root@example.com
# DJANGO_ADMINS=admin@example.com,ops@example.com

# Production-only (see config/settings/production.py)
# DATABASE_URL=sqlite:////data/site.sqlite3
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_BEHIND_PROXY=True
# DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com
# DJANGO_SITE_DOMAIN=example.com
# SENTRY_DSN=
# SENTRY_RELEASE=

# Litestream S3-compatible replica target
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
