# Django
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# Database (Postgres-in-Docker, see docker-compose.yml)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/fly_app

# Redis (cache, Celery broker/result backend)
REDIS_URL=redis://127.0.0.1:6379/0

# Object storage (MinIO locally, real S3 in prod)
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_STORAGE_BUCKET_NAME=fly-app
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=http://127.0.0.1:9000

# Email (Anymail / Postmark) - only used when DJANGO_DEBUG=False
POSTMARK_SERVER_TOKEN=
ANYMAIL_WEBHOOK_SECRET=
DEFAULT_FROM_EMAIL=no-reply@example.com
SERVER_EMAIL=server-errors@example.com

# Analytics
GA4_MEASUREMENT_ID=

# Error reporting (GlitchTip)
GLITCHTIP_DSN=
GLITCHTIP_TRACES_SAMPLE_RATE=0.0

# GDPR
DATA_RETENTION_DAYS=30
