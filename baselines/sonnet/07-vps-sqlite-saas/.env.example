# Copy to .env and fill in real values. Never commit the real .env file.

# --- Core ---
SECRET_KEY=change-me-to-a-random-50-char-secret
DEBUG=False
ALLOWED_HOSTS=example.com,www.example.com

# --- Email (production: SMTP via Postmark; local dev uses the console backend) ---
EMAIL_URL=smtp+tls://<token>:<token>@smtp.postmarkapp.com:587
DEFAULT_FROM_EMAIL=noreply@example.com
SERVER_EMAIL=root@example.com
# "Name:email,Name2:email2"
DJANGO_ADMINS=Admin:admin@example.com

# --- Error reporting ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.0

# --- Litestream (S3-compatible replication target) ---
LITESTREAM_BUCKET=your-bucket
LITESTREAM_PATH=07-vps-sqlite-saas/db
LITESTREAM_ACCESS_KEY_ID=changeme
LITESTREAM_SECRET_ACCESS_KEY=changeme
LITESTREAM_ENDPOINT=https://s3.example-region.example.com
