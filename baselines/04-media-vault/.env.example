# Copy to .env and adjust as needed. `manage.py`, `uvicorn` and `rqworker` all read this file.

DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO

# Postgres-in-Docker: `db` service in docker-compose.yml, published on 127.0.0.1:5432
DATABASE_URL=psql://media_vault:media_vault@127.0.0.1:5432/media_vault

# Redis: shared by the channel layer, the RQ task queue and django-rq
REDIS_URL=redis://127.0.0.1:6379/0

# Console backend locally; point at a real SMTP URL in production
EMAIL_URL=consolemail://

# S3-compatible storage: MinIO in local Compose
AWS_S3_ENDPOINT_URL=http://127.0.0.1:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_STORAGE_BUCKET_NAME=media-vault
AWS_S3_REGION_NAME=us-east-1

CORS_ALLOWED_ORIGINS=http://localhost:3000
