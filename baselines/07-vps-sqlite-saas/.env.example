# Copy to .env and fill in real values. Never commit the real .env file.

# Django
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string
DJANGO_ALLOWED_HOSTS=example.com,www.example.com
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=2592000

# SQLite paths (override in docker-compose.prod.yml to point at the data volume)
DJANGO_DB_PATH=db.sqlite3
DJANGO_CACHE_DB_PATH=cache.sqlite3
DJANGO_MEDIA_ROOT=media

# Email (Postmark SMTP relay in production; console backend in local dev regardless of this)
EMAIL_URL=smtp+tls://<token>:<token>@smtp.postmarkapp.com:587
DEFAULT_FROM_EMAIL=noreply@example.com
SERVER_EMAIL=root@example.com
DJANGO_ADMINS=Admin Name:admin@example.com

# Sentry
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_ENVIRONMENT=production

# Litestream -> S3-compatible storage
LITESTREAM_S3_BUCKET=my-app-backups
LITESTREAM_S3_PATH=db
LITESTREAM_S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
LITESTREAM_S3_REGION=us-east-1
LITESTREAM_ACCESS_KEY_ID=change-me
LITESTREAM_SECRET_ACCESS_KEY=change-me

# Caddy
DOMAIN=example.com
