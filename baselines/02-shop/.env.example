# Copy to .env and fill in real values. Never commit the real .env file.

DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com

# Used by Caddy (docker-compose.yml) as the site to serve/auto-TLS.
SITE_DOMAIN=example.com

# In docker-compose on the VPS, Postgres runs on the host, so use
# host.docker.internal instead of localhost.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/shop_db

EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=webmaster@example.com

STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
