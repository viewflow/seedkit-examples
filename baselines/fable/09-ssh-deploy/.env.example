# --- Django ------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com
# Set to "false" when TLS redirect is handled by the reverse proxy itself.
DJANGO_SECURE_SSL_REDIRECT=true

# --- Database ------------------------------------------------------------------
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# --- Redis ---------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/0
CACHE_REDIS_URL=redis://127.0.0.1:6379/1

# --- Deploy (docker-compose.prod.yml) --------------------------------------------
WEB_IMAGE=ghcr.io/OWNER/09-ssh-deploy:latest

# --- Analytics: self-hosted Umami ------------------------------------------------
UMAMI_HOST=https://umami.example.com
UMAMI_WEBSITE_ID=

# --- Error reporting: self-hosted Bugsink (sentry-sdk DSN) ------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# --- GDPR / retention --------------------------------------------------------------
DATA_RETENTION_DAYS=365
DBBACKUP_DIR=/app/backups
