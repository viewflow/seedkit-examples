DEBUG=true
DJANGO_SECRET_KEY=insecure-dev-only-secret-key-change-me
DATABASE_URL=postgres://media_vault:media_vault@127.0.0.1:5433/media_vault
REDIS_URL=redis://127.0.0.1:6380/0
EMAIL_URL=consolemail://

# S3-compatible storage (MinIO from docker-compose.yml)
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_STORAGE_BUCKET_NAME=media
AWS_S3_ENDPOINT_URL=http://127.0.0.1:9002

# Used by `manage.py createsuperuser --noinput`
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=admin
