# Core
DEBUG=true
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1

# Services (docker-compose defaults)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/fly_app
REDIS_URL=redis://127.0.0.1:6379/0

# S3-compatible storage (MinIO locally; unset AWS_S3_ENDPOINT_URL for real S3)
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_STORAGE_BUCKET_NAME=fly-app-media
AWS_S3_ENDPOINT_URL=http://127.0.0.1:9000
AWS_S3_REGION_NAME=us-east-1

# Email (console locally; Postmark via anymail in production)
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=noreply@example.com
SERVER_EMAIL=server@example.com
POSTMARK_SERVER_TOKEN=
ANYMAIL_WEBHOOK_SECRET=

# Analytics
GA4_MEASUREMENT_ID=

# Error reporting (GlitchTip, Sentry protocol)
GLITCHTIP_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.0

# GDPR
DATA_RETENTION_DAYS=365
