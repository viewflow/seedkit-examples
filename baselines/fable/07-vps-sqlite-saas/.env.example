# Copy to .env and adjust. Local development works without any of these.

# --- Core ---
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=change-me-generate-a-long-random-string
DJANGO_ALLOWED_HOSTS=example.com
# Public domain used by Caddy for automatic HTTPS.
DOMAIN=example.com

# --- Paths (inside the container) ---
SQLITE_DIR=/app/data
MEDIA_ROOT=/app/media

# --- E-mail (Postmark SMTP) ---
EMAIL_URL=smtp+tls://<token>:<token>@smtp.postmarkapp.com:587
DEFAULT_FROM_EMAIL=SaaS <no-reply@example.com>
SERVER_EMAIL=errors@example.com
# Comma-separated Name:email pairs.
DJANGO_ADMINS=Admin:admin@example.com

# --- Error reporting ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Litestream (S3-compatible replication) ---
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
LITESTREAM_BUCKET=my-backup-bucket
LITESTREAM_ENDPOINT=https://s3.example.com
