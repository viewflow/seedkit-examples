# Copy to `.env` and adjust. Values below match docker-compose.yml.

DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=dev-only-not-a-real-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,[::1]

# Host ports the compose services publish on. Bump these if the host already
# runs its own Postgres/Redis, and keep the URLs below in sync.
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/media_vault
REDIS_URL=redis://127.0.0.1:6379/0

# S3-compatible storage. Point AWS_S3_ENDPOINT_URL at MinIO locally; leave it
# empty (or drop the line) to talk to real AWS S3.
AWS_S3_ENDPOINT_URL=http://127.0.0.1:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_STORAGE_BUCKET_NAME=media
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ADDRESSING_STYLE=path

EMAIL_URL=consolemail://

CORS_ALLOW_ALL_ORIGINS=True
# CORS_ALLOWED_ORIGINS=http://localhost:3000

DJANGO_LOG_LEVEL=INFO
DJANGO_LOG_JSON=False

# Used by `manage.py createsuperuser --noinput`.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=admin
