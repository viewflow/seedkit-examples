# Copy to .env and adjust. Never commit the real .env.

DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=django-insecure-local-only-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SITE_URL=http://127.0.0.1:8000

DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/shop_db

# Production SMTP (unused locally — local uses the console backend)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DJANGO_DEFAULT_FROM_EMAIL=shop@example.com

# Stripe (test keys)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
