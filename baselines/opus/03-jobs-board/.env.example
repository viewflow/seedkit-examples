# Copy to .env and adjust as needed.
DEBUG=True
SECRET_KEY=django-insecure-change-me-in-production
ALLOWED_HOSTS=127.0.0.1,localhost

# Host ports published by docker-compose. Override if something already
# occupies 5432/6379 on your machine.
POSTGRES_PORT=5432
REDIS_PORT=6379

DATABASE_URL=postgres://jobsboard:jobsboard@127.0.0.1:5432/jobsboard
REDIS_URL=redis://127.0.0.1:6379/0

EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=jobs@example.com
