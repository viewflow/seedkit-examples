DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Port 5433, not the Postgres default 5432 — see docker-compose.yml comment.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/postgres

# Port 6380, not the Redis default 6379 — see docker-compose.yml comment.
REDIS_URL=redis://localhost:6380
# cache /0, channel layer /2, django-tasks-rq queue /3

AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_STORAGE_BUCKET_NAME=media-vault
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=http://localhost:9000
# AWS_S3_CUSTOM_DOMAIN=localhost:9000
AWS_S3_URL_PROTOCOL=http:

EMAIL_URL=consolemail://
# DEFAULT_FROM_EMAIL=webmaster@localhost
# SERVER_EMAIL=root@example.com
# DJANGO_ADMINS=admin@example.com,ops@example.com

DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
