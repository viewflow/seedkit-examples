DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_URL=postgres://postgres:postgres@localhost:5434/postgres

REDIS_URL=redis://localhost:6381

# S3 / MinIO — static + media storage
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_STORAGE_BUCKET_NAME=08-fly-app
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=http://localhost:9002
# AWS_S3_CUSTOM_DOMAIN=cdn.example.com
AWS_S3_URL_PROTOCOL=http:

# Email — Anymail (Postmark) in prod, console backend in dev
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=webmaster@localhost
# SERVER_EMAIL=root@example.com
# DJANGO_ADMINS=admin@example.com,ops@example.com
POSTMARK_SERVER_TOKEN=
ANYMAIL_WEBHOOK_SECRET=

# Analytics — GA4
ANALYTICS_ID=
ANALYTICS_HOST=

# Error reporting — GlitchTip (Sentry-protocol)
SENTRY_DSN=
# SENTRY_RELEASE=

